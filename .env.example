# Application
SOCIAL_AI_APP_NAME=Social AI Assistant
SOCIAL_AI_API_PREFIX=/api/v1
SOCIAL_AI_API_KEY=dev-api-key-change-me
SOCIAL_AI_DATABASE_URL=sqlite:///./data/app.db
SOCIAL_AI_CORS_ORIGINS=["*"]

# LLM provider, compatible with OpenAI / DeepSeek / Qwen / local endpoints
SOCIAL_AI_LLM_BASE_URL=https://api.openai.com/v1
SOCIAL_AI_LLM_API_KEY=
SOCIAL_AI_LLM_MODEL=gpt-4o-mini

# MediaCrawler integration
# Absolute or relative path to a local MediaCrawler clone. If empty or
# SOCIAL_AI_MOCK_CRAWLER=true, the app uses deterministic mock data.
SOCIAL_AI_MEDIA_CRAWLER_DIR=
SOCIAL_AI_MOCK_CRAWLER=true

# Background scheduler
SOCIAL_AI_SCHEDULE_ENABLED=false
